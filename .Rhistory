n = 1
)
scenario_D <- list(
tmean = exposure_tmean_D,
rain = exposure_rain_D,
wetness = exposure_wetness_D
)
comp_pred = compare_predictions(
fit = fit,
profiles = list(
A = scenario_A,
B = scenario_B,
C = scenario_C,
D = scenario_D
),
uncertainty = TRUE,
output =  "summary",
n_samples = 100
)
comp_pred <- comp_pred %>%
dplyr::mutate(
scenario = paste(scenario1, scenario2, sep = " x ")
)
comp_pred
comp_pred2 = compare_predictions(
fit = fit,
profiles = list(
A = scenario_A,
B = scenario_B,
C = scenario_C,
D = scenario_D
),
uncertainty = TRUE,
output =  "samples",
n_samples = 100
)
comp_pred2 <- comp_pred2 %>%
dplyr::mutate(
scenario = paste(scenario1, scenario2, sep = " x ")
)
comp_pred2
comp_pred22 = comp_pred2 |>
filter(scenario == "B x C")
t.test(comp_pred22$pred1, comp_pred22$pred2)
test_result <- wilcox.test(comp_pred22$pred1, comp_pred22$pred2,
alternative = "two.sided",
exact = FALSE,
conf.int = TRUE)
sc_simu_plot = ggplot(comp_pred,
aes(reorder(scenario, diff),
y = diff)) +
geom_jitter(
data = comp_pred2,
aes(
reorder(scenario, diff),
y = diff, color = sample
),
alpha = 0.4,
size = 2,
width = 0.2
) +
scale_color_viridis_b()+
geom_pointrange(
aes(
ymin = diff_lower,
ymax = diff_upper
),
linewidth = 0.6
)+
theme_bw() +
labs(
x = "Scenarios comparison",
y = "Difference"
)+
theme(text = element_text(size = 10, face = "bold"),
legend.position = "none")
