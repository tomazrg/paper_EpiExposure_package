df_tmean_B$scenario = "B"
df_tmean_C$var = "tmean"
df_tmean_C$scenario = "C"
df_tmean_D$var = "tmean"
df_tmean_D$scenario = "D"
df_rain_A$var = "rain"
df_rain_A$scenario = "A"
df_rain_B$var = "rain"
df_rain_B$scenario = "B"
df_rain_C$var = "rain"
df_rain_C$scenario = "C"
df_rain_D$var = "rain"
df_rain_D$scenario = "D"
df_wetness_A$var = "wetness"
df_wetness_A$scenario = "A"
df_wetness_B$var = "wetness"
df_wetness_B$scenario = "B"
df_wetness_C$var = "wetness"
df_wetness_C$scenario = "C"
df_wetness_D$var = "wetness"
df_wetness_D$scenario = "D"
df_simulations = rbind(df_tmean_A, df_tmean_B, df_tmean_C, df_tmean_D,
df_rain_A, df_rain_B, df_rain_C, df_rain_D,
df_wetness_A, df_wetness_B, df_wetness_C, df_wetness_D)
df_simulations <- df_simulations %>%
dplyr::mutate(
lag = max(time) - time
)
simu_plot = df_simulations %>%
ggplot(aes(time, value, color = var)) +
geom_line(linewidth = 1.0) +
facet_grid(var ~ scenario, scale = "free_y") +
theme_bw() +
labs(
x = "Lag",
y = "Exposure",
color = "Variable"
) +
scale_x_continuous(
limits = c(0, 85),
breaks = seq(0, 85, by = 15)
) +
scale_color_manual(
values = c(
tmean = "#C44E52",
rain = "#4C72B0",
wetness = "#55A868"
)
) +
theme(
text = element_text(size = 10, face = "bold"),
legend.position = "none",
strip.background = element_rect(color = "black", fill = "white"),
strip.text = element_text(face = "bold")
)
simu_plot
combined_plot <- cowplot::plot_grid(
sc_simu_plot,
simu_plot,
nrow = 1,
labels = c("(a)", "(b)"),
label_size = 12,
label_fontface = "bold",
label_x = 0.01,
label_y = 0.99,
hjust = 0,
vjust = 1
)
combined_plot
ggsave("fig/compare_predictions.png", dpi = 600, width = 10, height = 5.6)
range_losses <- simulate_ranges(
periods = period,
vary = list(
tmean = c(20,34),
rain = seq(0,15, by = 0.01),
wetness = c(2,10)
),
scenario_type = "grid",
scenario_var = "rain"
)
scenarios_losses = simulate_scenarios(
fit = fit,
scenarios = range_losses,
data = epi_data,
uncertainty = TRUE,
output = "summary",
n_samples = 20,
seed = 123)
scenarios_losses$prediction = scenarios_losses$prediction*100
scenarios_losses$prediction_lower = scenarios_losses$prediction_lower*100
scenarios_losses$prediction_upper = scenarios_losses$prediction_upper*100
losses = simulate_losses(
data = scenarios_losses,
lower = "prediction_lower",
upper = "prediction_upper",
y = "prediction",
slope = 49.3,
parameter_mode = "values",
intercept = 9691.0,
attainable_yield = seq(4000,12000, by = 50),
price = 300
)
losses_plot <- plot_losses(
data = losses,
x = "rain",
y = "att_yield",
y_label = expression(bold("Attainable yield" ~ ha^{-1})),
facet = c("tmean", "wetness"),
type = "heatmap",
x_breaks = seq(0, 15, by = 3),
y_breaks = seq(4000, 12000, by = 2000),
x_label = "Daily precipitation (mm)",
nrow = 2,
facet_ncol = 4)
losses_plot
losses_plot <- plot_losses(
data = losses,
x = "rain",
y = "att_yield",
y_label = expression(bold("Attainable yield" ~ ha^{-1})),
facet = c("tmean", "wetness"),
type = "heatmap",
x_breaks = seq(0, 15, by = 3),
y_breaks = seq(4000, 12000, by = 2000),
x_label = "Exposure",
nrow = 2,
facet_ncol = 4)
losses_plot
ggsave("fig/simulation_yld_ec_losses2.png", dpi = 600, bg = "white", height = 6, width = 10)
